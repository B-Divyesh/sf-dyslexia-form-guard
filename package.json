{
  "name": "dyslexia-form-guard",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:a11y": "node scripts/run-site-check.mjs",
    "test:popup-a11y": "node scripts/run-popup-check.mjs",
    "claim": "node scripts/run-claim.mjs",
    "test:billing-live": "node scripts/billing-live-check.mjs",
    "test:watch": "vitest",
    "build:extension": "wxt build",
    "package:extension": "node scripts/package-extension.mjs",
    "build:site": "vite build --config vite.site.config.ts && npm run build:extension && npm run package:extension",
    "build": "node scripts/build-all.mjs",
    "test:release": "node scripts/verify-release.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:release"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@proj-airi/font-departure-mono": "0.12.0-beta.4",
    "@types/archiver": "^6.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.30",
    "archiver": "^7.0.1",
    "eslint": "10.9.1",
    "jsdom": "^26.1.0",
    "playwright": "1.58.2",
    "sharp": "^0.35.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.68.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
